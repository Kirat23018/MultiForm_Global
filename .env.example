# MultiForm Global (MFG) - Environment Configuration Example
PORT=5000

# Nodemailer Email Configuration (Gmail App Password or SMTP)
TEAM_EMAIL=your_email@example.com
EMAIL_APP_PASSWORD=your_gmail_app_password
NOTIFICATION_EMAILS=your_email@example.com, admin@example.com

# SMTP Settings (Optional Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_gmail_app_password
